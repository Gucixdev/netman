#!/usr/bin/env bash
# install - build netman and install it for the current user: no arguments, no root.
# Binary to ~/.local/bin/netman, the default profiles to ~/.local/share/netman/profiles (found there at start).
# PREFIX=/usr/local (and sudo) installs system-wide; DESTDIR is honoured for packagers.
set -eu
cd "$(dirname "$(readlink -f "$0")")"
[ $# -eq 0 ] || { echo "install: takes no arguments (PREFIX=... in the environment changes the target)" >&2; exit 2; }
cc=${CC:-}
if [ -z "$cc" ]; then for c in cc gcc clang; do command -v "$c" > /dev/null 2>&1 && { cc=$c; break; }; done; fi
[ -n "$cc" ] || { echo "install: no C compiler found (cc, gcc or clang)" >&2; exit 1; }
prefix=${PREFIX:-$HOME/.local}
dest=${DESTDIR:-}$prefix

mkdir -p bin
CC="$cc" tools/cc -o bin/netman.tmp || { rm -f bin/netman.tmp; echo "install: the build failed" >&2; exit 1; }
mv bin/netman.tmp bin/netman
install -Dm755 bin/netman "$dest/bin/netman"
for f in share/profiles/*; do install -Dm644 "$f" "$dest/share/netman/profiles/$(basename "$f")"; done
echo "netman installed in $dest/bin/netman (profiles: $dest/share/netman/profiles)"
case ":$PATH:" in
	*":$dest/bin:"*) ;;
	*) [ -n "${DESTDIR:-}" ] || echo "note: $dest/bin is not in PATH; add it to your shell profile" ;;
esac
