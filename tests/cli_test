#!/usr/bin/env bash
# cli_test - the command table, help, man page, config gating and exit codes of the real binary. Nothing real is touched (privileges.sudo = never,
# disabled modules are refused before any backend is contacted).
set -u
cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
"$(dirname "$(readlink -f "$0")")/../tools/cc" -o "$work/netman" || exit 1
N="$work/netman"; pass=0 fail=0
ok() { pass=$((pass + 1)); }
no() { fail=$((fail + 1)); printf 'FAIL: %s\n' "$1"; }
export NETMAN_CONFIG="$work/c.conf"
printf '[privileges]\nsudo = never\n' >"$work/c.conf"
chk() { local want=$1 desc=$2; shift 2; local out rc; out=$("$@" 2>&1); rc=$?; [ "$rc" = "$want" ] && ok || no "$desc: rc $rc, wanted $want ($out)"; LAST=$out; }
contains() { grep -qF -- "$1" <<<"$LAST" && ok || no "$2: wanted '$1' in: $LAST"; }

chk 0 "help" "$N" help; contains "netman wifi connect" "help lists wifi connect"; contains "netman config toggle" "help lists config toggle"
chk 0 "help one command" "$N" help wifi connect; contains "needs root" "help command shows the root flag"
chk 0 "help group" "$N" help vpn; contains "vpn up" "help group"
chk 0 "help tui" "$N" help tui; contains "GENERAL" "help tui = popup text"
chk 0 "help config" "$N" help config; contains "wifi.backend" "help config lists keys"
chk 2 "help unknown" "$N" help nosuchthing
chk 2 "unknown command" "$N" frobnicate; contains "unknown command" "unknown command message"
chk 2 "a typo suggests the command" "$N" stauts; contains "did you mean 'status'" "typo suggestion"
chk 2 "a bare group lists its commands" "$N" wifi; contains "netman wifi connect" "bare group lists the group"; contains "'wifi' needs a command" "bare group message"
chk 2 "bare config lists its commands, not every key" "$N" config; contains "netman config show" "bare config"
chk 2 "unknown word in a group" "$N" wifi frob; contains "unknown command 'wifi frob'" "group + unknown word"; contains "netman wifi list" "group listing after a bad word"
printf '[privileges]\nsudo = always\n' >"$work/always.conf"
chk 0 "the sudo notice names the command (sudo itself is a fake: true)" env NETMAN_CONFIG="$work/always.conf" NM_SUDO_CMD=true "$N" vpn up x; contains "\`vpn\` needs root; asking sudo" "sudo notice"
[ "${LAST#*wpa_supplicant socket}" = "$LAST" ] && ok || no "the sudo notice still blames wpa_supplicant for every command"
# ./install into a scratch prefix: binary, man page and the default profiles land under it, nothing under $HOME
chk 0 "install into a prefix" env PREFIX="$work/pfx" HOME="$work/nohome" ./install; contains "installed in $work/pfx/bin/netman" "install says where"
[ -x "$work/pfx/bin/netman" ] && [ -s "$work/pfx/share/man/man1/netman.1" ] && [ -f "$work/pfx/share/netman/profiles/example.ssh" ] && ok || no "install left binary, man page and profiles under the prefix"
[ ! -e "$work/nohome" ] && ok || no "install wrote under HOME although PREFIX was set"
chk 2 "install takes only -rebuild" ./install --frob; contains "-rebuild" "install usage"
chk 0 "--version" "$N" --version; contains "netman " "--version prints the name"; v=$LAST
chk 0 "-V" "$N" -V; [ "$LAST" = "$v" ] && ok || no "-V differs from --version"
chk 0 "version command" "$N" version; [ "$LAST" = "$v" ] && ok || no "version differs from --version"
case $v in "netman "[0-9]*.[0-9]*.[0-9]*) ok;; *) no "version line is 'netman X.Y.Z': $v";; esac
# every table row has help text and is reachable from `netman help`
"$N" help >"$work/all"; "$N" help --man >"$work/man"
cmp -s "$work/man" src/netman.1 && ok || no "src/netman.1 is out of date (regenerate: netman help --man > src/netman.1)"
rows=$(grep -c '^  netman ' "$work/all"); [ "$rows" -ge 50 ] && ok || no "help lists $rows rows"
# the link modules are ordinary modules (no "enterprise" switch): each group is gated by its own enabled key, the old ent group by the profile's module
for m in bridge vlan route link dot1x tether; do
	chk 0 "help $m" "$N" help "$m"; contains "netman $m " "help $m lists its commands"
	chk 3 "$m list is refused while $m is off" "$N" "$m" list
done
chk 3 "bridge add refused while bridge is off" "$N" bridge add x; contains "disabled in config" "bridge off message"
chk 3 "route ecmp refused while route is off" "$N" route ecmp x
chk 0 "old ent group still exists" "$N" help ent
"$N" help >"$work/all2"; grep -qi enterprise "$work/all2" && no "help still says enterprise" || ok
chk 0 "old [enterprise] section loads" env NETMAN_CONFIG=/dev/stdin "$N" config check <<<"$(printf '[privileges]\nsudo = never\n[enterprise]\nenabled = yes\n')"
printf '[privileges]\nsudo = never\n[enterprise]\nenabled = yes\n' >"$work/old.conf"
chk 0 "old enterprise.enabled turns the modules on" env NETMAN_CONFIG="$work/old.conf" "$N" settings get route.enabled; contains "yes" "route enabled by the old key"
chk 0 "old env NETMAN_ENTERPRISE_ENABLED" env NETMAN_ENTERPRISE_ENABLED=yes "$N" settings get vlan.enabled; contains "yes" "vlan enabled by the old variable"
# shipped default profiles (share/profiles): ssh / mesh / tunnel show ready example rows out of the box, a profile of the same name in the dir wins
printf '[privileges]\nsudo = never\n[ssh]\nenabled = yes\ndir = %s/ssh\n[mesh]\nenabled = yes\ndir = %s/mesh\n[tunnel]\nenabled = yes\ndir = %s/tun\n' "$work" "$work" "$work" >"$work/p.conf"
for m in ssh mesh tunnel; do
	chk 0 "$m status with the shipped profiles" env NETMAN_CONFIG="$work/p.conf" NETMAN_SHARE_DIR="$PWD/share" "$N" "$m" status; contains "example" "$m: the shipped example profile is listed"
	[ "${LAST#*no $m profile}" = "$LAST" ] && ok || no "$m: still says 'no $m profile'"
done
chk 0 "ssh show a shipped profile" env NETMAN_CONFIG="$work/p.conf" NETMAN_SHARE_DIR="$PWD/share" "$N" ssh show example; contains "host = ssh.example.org" "ssh show reads the shipped file"
mkdir -p "$work/ssh"; printf 'host = mine.example.net\n' >"$work/ssh/example.ssh"
chk 0 "a user profile shadows the shipped one" env NETMAN_CONFIG="$work/p.conf" NETMAN_SHARE_DIR="$PWD/share" "$N" ssh show example; contains "mine.example.net" "user copy wins"
chk 0 "without the share dir nothing is shown" env NETMAN_CONFIG="$work/p.conf" NETMAN_SHARE_DIR="$work/none" "$N" mesh status; contains "no mesh profiles" "empty mesh list as before"
# config
chk 0 "config check" "$N" config check
chk 0 "config show" "$N" config show; contains "rssi_good" "show lists keys"
chk 0 "config set" "$N" config set wifi.rssi_good -50; chk 0 "config show after set" "$N" config show; contains "-50" "set value shown"
chk 1 "config set bad value" "$N" config set wifi.rssi_good banana
chk 1 "config typo" "$N" config set wifi.rssi_god -50; contains "wifi.rssi_good" "did-you-mean"
chk 0 "config example" "$N" config example; contains "[wifi]" "example has sections"
# module gating
chk 0 "toggle wifi off" "$N" config toggle wifi.enabled
chk 3 "disabled wifi" "$N" wifi list; contains "wifi disabled in config" "disabled message"
chk 3 "disabled wifi connect" "$N" wifi connect X
chk 0 "toggle wifi back" "$N" config toggle wifi.enabled
chk 0 "toggle vpn off" "$N" config toggle vpn.enabled; chk 3 "disabled vpn" "$N" vpn list; contains "vpn disabled in config" "vpn message"
chk 0 "fw plan still works when firewall is off" "$N" config set firewall.enabled no; chk 3 "fw apply gated" "$N" fw apply x; contains "firewall disabled" "fw message"
# wireguard: keys are pure, peer commands validate before any netlink call, the module toggle gates
chk 0 "wg genkey" "$N" wg genkey; [ "${#LAST}" = 44 ] && ok || no "genkey length"; key=$LAST
chk 0 "wg pubkey" bash -c "echo $key | $N wg pubkey"; [ "${#LAST}" = 44 ] && [ "$LAST" != "$key" ] && ok || no "pubkey"
chk 0 "wg genpsk" "$N" wg genpsk; [ "${#LAST}" = 44 ] && ok || no "genpsk length"
chk 2 "wg peer add bad key" "$N" wg peer add wg0 notakey; contains "not a WireGuard key" "bad key message"
chk 2 "wg peer endpoint bad endpoint" "$N" wg peer endpoint wg0 "$key" nonsense; contains "cannot resolve endpoint" "bad endpoint message"
chk 2 "wg peer add bad option" "$N" wg peer add wg0 "$key" foo=1; contains "unknown option" "bad option message"
chk 0 "toggle wireguard off" "$N" config toggle wireguard.enabled; chk 3 "disabled wireguard" "$N" wg show; contains "wireguard disabled in config" "wireguard message"
chk 0 "toggle wireguard back" "$N" config toggle wireguard.enabled
printf 'this is not = [valid\n' >"$work/c.conf"
chk 1 "broken config stops commands" "$N" status; chk 0 "help works with a broken config" "$N" help; chk 1 "config check reports it" "$N" config check
echo "cli: $pass ok, $fail failed"
[ "$fail" -eq 0 ]
