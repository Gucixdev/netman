#!/usr/bin/env bash
# tests/run - build and run every netman test, no arguments. Prints one line per test and a summary; exit 0 only if all passed (skips are listed).
#  - unit tests (tests/*_test.c) run inside `unshare -Urnm` (own user, network and mount namespace, /sys re-mounted): the host network is never touched
#  - the script tests (cli_test, settings_cli_test, nmapi_test, pty*) make their own namespaces / private tmux servers and fake backends
# Needs: cc, unshare, tmux, dbus-daemon (a missing tool skips what needs it). The module file lists come from src/sources, so moving a module needs no edit here.
# Run it on an idle machine: the tmux (pty*) tests wait on screen text and can miss a deadline when the CPU is busy.
set -u
cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
O=$(mktemp -d); trap 'rm -rf "$O"' EXIT
pick() { grep -E "/($1)\\.c\$" src/sources | tr '\n' ' '; }
NL=$(pick 'netlink|wol|tether|licence')
VPN=$(pick 'wireguard|vpnmod|openvpn|ipsec|l2tp|openconnect|sstp|vpnimport|tor')
MOD() { pick "$1"; }
pass=0; failed=""; skipped=""
note() { printf '%-22s %s\n' "$1" "$2"; }
fin() { # name rc
	case $2 in 0) pass=$((pass + 1)); note "$1" ok;; 77) skipped="$skipped $1"; note "$1" skipped;; *) failed="$failed $1"; note "$1" "FAILED (rc $2)";; esac
}
if ! command -v unshare >/dev/null 2>&1; then echo "tests/run: unshare is missing; only the pure tests can run" >&2; fi
unit() { # name [cc flags and extra sources...] ; runs from the repo root (goldens are tests/...); WD=tests for vpn_test (reads ./vpn_testdata)
	local n=$1 rc; shift
	if ! cc -std=gnu11 -O1 -Wno-format-truncation -Isrc -Isrc/mods -o "$O/$n" "tests/$n.c" "$@" 2>"$O/$n.err"; then head -5 "$O/$n.err" >&2; fin "$n" 1; return; fi
	( cd "${WD:-.}" && unshare -Urnm sh -c 'mount -t sysfs sysfs /sys 2>/dev/null; exec "$0" "$@"' "$O/$n" ${ARGS:-} >"$O/$n.out" 2>&1 ); rc=$?
	[ "$rc" != 0 ] && tail -8 "$O/$n.out" >&2
	fin "$n" "$rc"
}
script() { local n=$1 rc; "tests/$n" >"$O/$n.out" 2>&1; rc=$?; [ "$rc" != 0 ] && grep -v 'warning\|note:\|^ *[0-9]* |\|^ *|' "$O/$n.out" | tail -12 >&2; fin "$n" "$rc"; }

unit config_test src/config.c
unit settings_test src/settings.c src/config.c
unit priv_test
unit fw_test
unit wifi_bt_test
ARGS=selftest unit net_test
unit net_score_test
unit netlink_test $NL
unit bonding_test $(MOD bonding) $NL
unit ssh_test $(MOD ssh) $NL
unit tunnel_test $(MOD tunnel) $NL
unit mesh_test $(MOD mesh) $VPN $NL
WD=tests unit vpn_test $VPN
unit vpnmod_test $VPN
unit tor_test $VPN
unit logic_test -DNETMAN_NO_MAIN src/config.c $NL $VPN $(MOD 'ssh|mesh|bonding|tunnel')
for t in cli_test settings_cli_test nmapi_test pty pty_mods pty_settings pty_tor pty_vpn pty_netlink; do script "$t"; done

echo "----"
echo "passed: $pass"
[ -n "$skipped" ] && echo "skipped:$skipped"
[ -n "$failed" ] && { echo "FAILED:$failed"; exit 1; }
echo "tests/run: all green"
