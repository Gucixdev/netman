#!/usr/bin/env bash
# run - ./build (parallel, incremental), then open its terminal UI. No arguments; the CLI is bin/netman (`bin/netman help`).
# Needs only a C compiler (cc, gcc or clang). Root is asked for by netman itself (sudo password prompt) and only when the backend needs it.
set -eu
cd "$(dirname "$(readlink -f "$0")")" || exit 1
./build > /dev/null || exit 1
exec bin/netman -tui
